# コピーして .env にし、chmod 600。値はここでは全部プレースホルダ。
COMPOSE_PROJECT_NAME=honcho

# --- 共有 PostgreSQL（postgresql-docker）。README の手順でロールと DB を先に作る。パスワードに @ : / # % が入るなら URL エンコード ---
HONCHO_DB_USER=honcho
HONCHO_DB_NAME=honcho
HONCHO_DB_PASSWORD=CHANGE_ME

# --- 認証。外に出さず 127.0.0.1 だけなら false でよいが、true を勧める。true のとき JWT 秘密鍵が要る（python scripts/generate_jwt_secret.py） ---
HONCHO_AUTH_USE_AUTH=false
HONCHO_AUTH_JWT_SECRET=

# --- LLM：OpenCode Go に直結 ---
# 鍵の置き場はここだけ（.env は chmod 600、チャットに貼らない）
OPENCODE_API_KEY=CHANGE_ME
# モデル ID は https://opencode.ai/v2/docs/console/go/ の表の "DeepSeek V4.1 Flash" の行（opencode-go/ の接頭辞なしの形）
HONCHO_LLM_MODEL=deepseek-v4.1-flash
# 文書の表の chat/completions の URL から /chat/completions を除いたもの
HONCHO_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# 各モジュールの provider_params（JSON）。OpenCode Go が求める User-Agent と x-opencode-session をここで付ける。
# 空なら compose の既定（honcho-nilkani06/1.0、セッション名 honcho-nilkani06）。セッションは固定値（README）
# HONCHO_LLM_PROVIDER_PARAMS={"extra_headers":{"User-Agent":"honcho-nilkani06/1.0","x-opencode-session":"honcho-nilkani06"}}

# --- 埋め込み：llama-docker の共有埋め込みサーバー llama-embed の bge-m3（OpenAI 互換の /v1/embeddings）。鍵はサーバーが見ないので埋め草 ---
HONCHO_EMBEDDING_BASE_URL=http://llama-embed:8080/v1
HONCHO_EMBEDDING_MODEL=bge-m3
HONCHO_EMBEDDING_API_KEY=none
# モデルの出力次元と一致させる（bge-m3 は 1024）。DB の列の型になるので、変えたら README の configure_embeddings を流し直す
HONCHO_EMBEDDING_DIMENSIONS=1024
HONCHO_EMBEDDING_BATCH_SIZE=16

HONCHO_LOG_LEVEL=INFO
HONCHO_IMAGE_TAG=dev
